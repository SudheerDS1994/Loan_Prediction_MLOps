pipeline {
    agent any
    
    options {
        timestamps()
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    
    environment {
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_IMAGE_NAME = 'loan-predictor'
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"
        KUBECONFIG = '/home/jenkins/.kube/config'
    }
    
    stages {
        stage('Clone Repository') {
            steps {
                echo '========== Cloning Repository =========='
                git branch: 'main', url: 'https://github.com/SudheerDS1994/Loan_Prediction_MLOps.git'
            }
        }
        
        stage('Setup Environment') {
            steps {
                echo '========== Setting up Environment =========='
                sh '''
                    python -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }
        
        stage('Run Unit Tests') {
            steps {
                echo '========== Running Unit Tests =========='
                sh '''
                    . venv/bin/activate
                    pytest tests/ -v --cov=api --cov=model --cov-report=xml
                '''
            }
        }
        
        stage('Code Quality Analysis') {
            steps {
                echo '========== Code Quality Analysis =========='
                sh '''
                    . venv/bin/activate
                    pip install pylint
                    pylint api/ model/ || true
                '''
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo '========== Building Docker Image =========='
                sh '''
                    docker build -t ${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG} -f docker/Dockerfile .
                    docker tag ${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG} ${DOCKER_IMAGE_NAME}:latest
                '''
            }
        }
        
        stage('Run Docker Container Tests') {
            steps {
                echo '========== Testing Docker Container =========='
                sh '''
                    docker run --rm ${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG} python -m pytest tests/ -v
                '''
            }
        }
        
        stage('Push to Registry') {
            when {
                branch 'main'
            }
            steps {
                echo '========== Pushing to Docker Registry =========='
                sh '''
                    echo "Pushing image to registry"
                    # docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}
                    # docker push ${DOCKER_REGISTRY}/${DOCKER_IMAGE_NAME}:latest
                '''
            }
        }
        
        stage('Deploy to Kubernetes') {
            when {
                branch 'main'
            }
            steps {
                echo '========== Deploying to Kubernetes =========='
                sh '''
                    kubectl apply -f k8s/configmap.yaml
                    kubectl apply -f k8s/deployment.yaml
                    kubectl apply -f k8s/service.yaml
                    kubectl rollout status deployment/loan-predictor-deployment -n default
                '''
            }
        }
        
        stage('Verify Deployment') {
            when {
                branch 'main'
            }
            steps {
                echo '========== Verifying Deployment =========='
                sh '''
                    kubectl get pods -n default
                    kubectl get svc -n default
                    sleep 10
                    kubectl exec -it $(kubectl get pod -n default -l app=loan-predictor -o jsonpath='{.items[0].metadata.name}') -- curl http://localhost:8080/health || true
                '''
            }
        }
    }
    
    post {
        success {
            echo '========== Pipeline Succeeded =========='
        }
        failure {
            echo '========== Pipeline Failed =========='
        }
        always {
            cleanWs()
        }
    }
}